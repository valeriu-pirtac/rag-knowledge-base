# Environment Configuration
# Copy this file to .env and fill in values as needed.

# ---- Application ----
APP_NAME=rag-knowledge-base
APP_ENV=dev

# ---- Observability ----
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true

# ---- Server ----
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ---- Network (Infrastructure) ----
NETWORK_NAME=rag_network

# ---- PostgreSQL ----
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_pass
POSTGRES_DB=rag_knowledge_base
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- NATS ----
NATS_CLIENT_PORT=4222
NATS_HTTP_PORT=8222

# ---- Garage (S3-compatible storage) ----
GARAGE_S3_PORT=3900
GARAGE_WEB_PORT=3901
GARAGE_RPC_PORT=3902
GARAGE_ADMIN_PORT=3903
GARAGE_RPC_SECRET=a445b6c8f7d9e0a1b2c3d4e5f6071829a445b6c8f7d9e0a1b2c3d4e5f6071829
GARAGE_LOG_LEVEL=garage=info
